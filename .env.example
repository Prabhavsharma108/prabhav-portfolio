# Contact form delivery. Get a free access key at https://web3forms.com and set
# it here locally, plus in the Vercel project's Environment Variables.
# Without it the contact form reports an error instead of silently going nowhere.
VITE_WEB3FORMS_KEY=

# Optional analytics. Leave blank and the PostHog script is never downloaded.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
